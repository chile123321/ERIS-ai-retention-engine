{
  "info": {
    "name": "ERIS Model API v1 — B2 research candidate",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual synthetic tests only. Start a ready local B2 service and set service_key locally; never export credentials. OpenAPI is the canonical contract."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "service_key",
      "value": ""
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"No secret echoed\", () => { const key=pm.variables.get(\"service_key\"); if(key) pm.expect(pm.response.text()).not.to.include(key); });",
          "pm.test(\"No decision fields\", () => { const visit = o => { if(o && typeof o===\"object\"){ Object.keys(o).forEach(k=>{pm.expect([\"threshold\",\"risk_level\",\"will_leave\"].includes(k)).to.eql(false); visit(o[k]);}); }}; visit(pm.response.json()); });",
          "pm.test(\"Safe errors\", () => { if(pm.response.code>=400){ const text=pm.response.text(); pm.expect(text).not.to.match(/Traceback|[A-Z]:[\\\\/]|\\/app\\/|\\/usr\\/|site-packages/i); pm.expect(pm.response.json()).to.have.property(\"code\"); }});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 — Public",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Alive\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{base_url}}/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Ready\", () => pm.expect(pm.response.json().status).to.eql(\"ready\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 — Protected model API",
      "item": [
        {
          "name": "Model info",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "X-ERIS-Service-Key",
                "value": "{{service_key}}"
              }
            ],
            "url": "{{base_url}}/v1/model/info"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Frozen B2 metadata\", () => { const j = pm.response.json(); const m = j.metadata || (j.result && j.result.metadata) || (j.results && j.results[0].metadata) || j; pm.expect(m.model_id).to.eql(\"rf-v3-final15-unweighted-b2\"); pm.expect(m.model_status).to.eql(\"research_candidate\"); pm.expect(m.independent_validation).to.eql(false); pm.expect(m.decision_support_only).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Predict one valid",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-ERIS-Service-Key",
                "value": "{{service_key}}"
              }
            ],
            "url": "{{base_url}}/v1/predict",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_id\": \"synthetic-one\",\n  \"features\": {\n    \"Age\": 35,\n    \"Department\": \"Research & Development\",\n    \"DistanceFromHome\": 5,\n    \"Education\": 3,\n    \"EnvironmentSatisfaction\": 3,\n    \"JobLevel\": 2,\n    \"JobSatisfaction\": 3,\n    \"MonthlyIncome\": 5000,\n    \"OverTime\": \"No\",\n    \"TotalWorkingYears\": 10,\n    \"TrainingTimesLastYear\": 3,\n    \"YearsAtCompany\": 5,\n    \"YearsInCurrentRole\": 3,\n    \"YearsSinceLastPromotion\": 1,\n    \"YearsWithCurrManager\": 3\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Finite probability [0,1]\", () => { const j=pm.response.json(); const rows=j.results || [j.result || j]; rows.forEach(r => {pm.expect(Number.isFinite(r.estimated_probability)).to.eql(true); pm.expect(r.estimated_probability).to.be.within(0,1);}); });",
                  "pm.test(\"Frozen B2 metadata\", () => { const j = pm.response.json(); const m = j.metadata || (j.result && j.result.metadata) || (j.results && j.results[0].metadata) || j; pm.expect(m.model_id).to.eql(\"rf-v3-final15-unweighted-b2\"); pm.expect(m.model_status).to.eql(\"research_candidate\"); pm.expect(m.independent_validation).to.eql(false); pm.expect(m.decision_support_only).to.eql(true); });"
                ]
              }
            }
          ]
        },
