ERIS_ENVIRONMENT=development
ERIS_MODEL_BUNDLE_PATH=artifacts/models/eris_xgboost_v1.joblib
ERIS_MODEL_METADATA_PATH=artifacts/models/eris_xgboost_v1.metadata.json
ERIS_MODEL_CHECKSUM_PATH=artifacts/models/eris_xgboost_v1.sha256
ERIS_API_HOST=127.0.0.1
ERIS_API_PORT=8000
ERIS_API_LOG_LEVEL=INFO
ERIS_MAX_BATCH_SIZE=100
ERIS_CORS_ORIGINS=
# Set a unique 32+ character value in the backend/API runtime environment.
# Never put this credential in frontend code or commit a real value.
ERIS_SERVICE_TOKEN=<SET_A_LONG_RANDOM_TOKEN_IN_RUNTIME_ENV>
