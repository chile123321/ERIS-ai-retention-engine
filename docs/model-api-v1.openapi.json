              "Human Resources",
              "Research & Development",
              "Sales"
            ],
            "title": "Department",
            "type": "string"
          },
          "DistanceFromHome": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Distancefromhome",
            "type": "integer"
          },
          "Education": {
            "enum": [
              1,
              2,
              3,
              4,
              5
            ],
            "title": "Education",
            "type": "integer"
          },
          "EnvironmentSatisfaction": {
            "enum": [
              1,
              2,
              3,
              4
            ],
            "title": "Environmentsatisfaction",
            "type": "integer"
          },
          "JobLevel": {
            "enum": [
              1,
              2,
              3,
              4,
              5
            ],
            "title": "Joblevel",
            "type": "integer"
          },
          "JobSatisfaction": {
            "enum": [
              1,
              2,
              3,
              4
            ],
            "title": "Jobsatisfaction",
            "type": "integer"
          },
          "MonthlyIncome": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Monthlyincome",
            "type": "integer"
          },
          "OverTime": {
            "enum": [
              "No",
              "Yes"
            ],
            "title": "Overtime",
            "type": "string"
          },
          "TotalWorkingYears": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Totalworkingyears",
            "type": "integer"
          },
          "TrainingTimesLastYear": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trainingtimeslastyear"
          },
          "YearsAtCompany": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Yearsatcompany",
            "type": "integer"
          },
          "YearsInCurrentRole": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Yearsincurrentrole",
            "type": "integer"
          },
          "YearsSinceLastPromotion": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Yearssincelastpromotion",
            "type": "integer"
          },
          "YearsWithCurrManager": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Yearswithcurrmanager"
          }
        },
        "required": [
          "Age",
          "Department",
          "DistanceFromHome",
          "Education",
          "EnvironmentSatisfaction",
          "JobLevel",
          "JobSatisfaction",
          "MonthlyIncome",
          "OverTime",
          "TotalWorkingYears",
          "YearsAtCompany",
          "YearsInCurrentRole",
          "YearsSinceLastPromotion"
        ],
        "title": "EmployeeFeatures",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Allowlisted locations/reasons only: no submitted values or exception text.",
        "properties": {
          "field": {
            "anyOf": [
              {
                "enum": [
                  "Age",
                  "Department",
                  "DistanceFromHome",
                  "Education",
                  "EnvironmentSatisfaction",
                  "JobLevel",
                  "JobSatisfaction",
                  "MonthlyIncome",
                  "OverTime",
                  "TotalWorkingYears",
                  "TrainingTimesLastYear",
                  "YearsAtCompany",
                  "YearsInCurrentRole",
                  "YearsSinceLastPromotion",
                  "YearsWithCurrManager"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "body",
                  "request_id",
                  "reference_id",
                  "features",
                  "items"
                ],
                "type": "string"
              }
            ],
            "title": "Field"
          },
          "issue": {
            "enum": [
              "required",
              "invalid_type",
              "out_of_range",
              "invalid_value",
              "extra_fields",
              "duplicate_reference_id",
              "empty_batch",
              "batch_too_large"
            ],
            "title": "Issue",
            "type": "string"
          },
          "item_index": {
            "anyOf": [
              {
                "maximum": 99.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Index"
          }
        },
        "required": [
          "field",
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AUTH_MISSING",
              "AUTH_INVALID",
              "VALIDATION_ERROR",
              "BATCH_TOO_LARGE",
              "MODEL_NOT_READY",
              "BUNDLE_INTEGRITY_ERROR",
              "INFERENCE_ERROR",
              "EXPLANATION_ERROR",
              "MODEL_UNKNOWN",
              "EXPLANATION_BUSY",
              "EXPLANATION_TIMEOUT"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExplainRequest": {
        "additionalProperties": false,
        "description": "Same request shape as single prediction.",
        "properties": {
          "features": {
            "$ref": "#/components/schemas/EmployeeFeatures"
          },
          "model_id": {
            "default": "rf-v3-final15-unweighted-b2",
            "title": "Model Id",
            "type": "string"
          },
          "reference_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reference Id",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "reference_id",
          "features"
        ],
        "title": "ExplainRequest",
        "type": "object"
      },
      "ExplainResponse": {
        "additionalProperties": false,
        "properties": {
          "additivity_error": {
            "minimum": 0.0,
            "title": "Additivity Error",
            "type": "number"
          },
          "base_value": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Base Value",
            "type": "number"
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/ShapContribution"
            },
            "maxItems": 15,
            "minItems": 15,
            "title": "Contributions",
            "type": "array"
          },
          "estimated_probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Estimated Probability",
            "type": "number"
          },
          "explanation_space": {
            "const": "probability",
            "default": "probability",
            "title": "Explanation Space",
            "type": "string"
          },
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelMetadata"
              },
              {
                "$ref": "#/components/schemas/AdaBoostMetadata"
              }
            ],
            "title": "Metadata"
          },
          "reference_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reference Id",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "top_factors": {
            "items": {
              "$ref": "#/components/schemas/ShapContribution"
            },
            "maxItems": 5,
            "title": "Top Factors",
            "type": "array"
          },
          "warning": {
            "const": "SHAP explains model behavior; it does not establish causality.",
            "default": "SHAP explains model behavior; it does not establish causality.",
            "title": "Warning",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "reference_id",
          "estimated_probability",
          "base_value",
          "contributions",
          "top_factors",
          "additivity_error",
          "metadata"
        ],
        "title": "ExplainResponse",
        "type": "object"
      },
      "ModelListResponse": {
        "additionalProperties": false,
        "properties": {
          "default_model_id": {
            "const": "rf-v3-final15-unweighted-b2",
