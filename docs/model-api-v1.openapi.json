      "ModelMetadata": {
        "additionalProperties": false,
        "properties": {
          "decision_support_only": {
            "const": true,
            "default": true,
            "title": "Decision Support Only",
            "type": "boolean"
          },
          "feature_schema_version": {
            "const": "v3_final_15",
            "default": "v3_final_15",
            "title": "Feature Schema Version",
            "type": "string"
          },
          "independent_validation": {
            "const": false,
            "default": false,
            "title": "Independent Validation",
            "type": "boolean"
          },
          "model_id": {
            "const": "rf-v3-final15-unweighted-b2",
            "default": "rf-v3-final15-unweighted-b2",
            "title": "Model Id",
            "type": "string"
          },
          "model_sha256": {
            "const": "0c72841a8505a910d31c2a687fbcbf5259e3afb60f9eddcb7586801519b5628f",
            "default": "0c72841a8505a910d31c2a687fbcbf5259e3afb60f9eddcb7586801519b5628f",
            "title": "Model Sha256",
            "type": "string"
          },
          "model_status": {
            "const": "research_candidate",
            "default": "research_candidate",
            "title": "Model Status",
            "type": "string"
          }
        },
        "title": "ModelMetadata",
        "type": "object"
      },
      "PredictRequest": {
        "additionalProperties": false,
        "properties": {
          "features": {
            "$ref": "#/components/schemas/EmployeeFeatures"
          },
          "model_id": {
            "default": "rf-v3-final15-unweighted-b2",
            "title": "Model Id",
            "type": "string"
          },
          "reference_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reference Id",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
