          }
        },
        "required": [
          "reference_id",
          "features"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "PredictResponse": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/PredictionResult"
          }
        },
        "required": [
          "request_id",
          "result"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "PredictionResult": {
        "additionalProperties": false,
        "properties": {
          "estimated_probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Estimated Probability",
            "type": "number"
          },
          "imputed_features": {
            "items": {
              "enum": [
                "TrainingTimesLastYear",
                "YearsWithCurrManager"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "title": "Imputed Features",
            "type": "array"
          },
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelMetadata"
              },
              {
                "$ref": "#/components/schemas/AdaBoostMetadata"
