            "title": "Decision Support Only",
            "type": "boolean"
          },
          "feature_schema_version": {
            "const": "v3_final_15",
            "default": "v3_final_15",
            "title": "Feature Schema Version",
            "type": "string"
          },
          "independent_validation": {
            "const": false,
            "default": false,
            "title": "Independent Validation",
            "type": "boolean"
          },
          "model_id": {
            "const": "adaboost-v3-final15-baseline-sigmoid-s1",
            "default": "adaboost-v3-final15-baseline-sigmoid-s1",
            "title": "Model Id",
            "type": "string"
          },
          "model_sha256": {
            "const": "af7dab8f6044c9a902789fd8b69aac16c4e187157508780c54cd1b39b1a491ca",
            "default": "af7dab8f6044c9a902789fd8b69aac16c4e187157508780c54cd1b39b1a491ca",
            "title": "Model Sha256",
            "type": "string"
          },
          "model_status": {
            "const": "research_candidate",
            "default": "research_candidate",
            "title": "Model Status",
            "type": "string"
          }
        },
        "title": "AdaBoostMetadata",
        "type": "object"
      },
      "AvailableModel": {
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelMetadata"
              },
              {
                "$ref": "#/components/schemas/AdaBoostMetadata"
              }
            ],
            "title": "Metadata"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "supports_explain": {
            "const": true,
            "default": true,
            "title": "Supports Explain",
            "type": "boolean"
          }
        },
        "required": [
          "metadata",
          "ready"
        ],
        "title": "AvailableModel",
        "type": "object"
      },
      "BatchItem": {
        "additionalProperties": false,
        "properties": {
          "features": {
            "$ref": "#/components/schemas/EmployeeFeatures"
          },
          "reference_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reference Id",
            "type": "string"
          }
        },
        "required": [
          "reference_id",
          "features"
        ],
        "title": "BatchItem",
        "type": "object"
      },
      "BatchPredictRequest": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "model_id": {
            "default": "rf-v3-final15-unweighted-b2",
            "title": "Model Id",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "items"
        ],
        "title": "BatchPredictRequest",
        "type": "object"
      },
      "BatchPredictResponse": {
        "additionalProperties": false,
        "description": "List order is preserved; future service must match it to request item order.",
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/PredictionResult"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "results"
        ],
        "title": "BatchPredictResponse",
        "type": "object"
      },
      "EmployeeFeatures": {
        "additionalProperties": false,
